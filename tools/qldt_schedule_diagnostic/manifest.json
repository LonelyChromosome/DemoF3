{
  "manifest_version": 3,
  "name": "DemoF3 QLDT Schedule Diagnostic",
  "version": "1.1.0",
  "description": "Check the QLDT schedule request locally without exporting account data.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://qldtbeta.phenikaa-uni.edu.vn/*"],
  "content_scripts": [
    {
      "matches": ["https://qldtbeta.phenikaa-uni.edu.vn/*"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "DemoF3 QLDT Schedule Diagnostic",
    "default_popup": "popup.html"
  }
}
