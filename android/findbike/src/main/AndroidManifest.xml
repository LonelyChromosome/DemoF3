<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <application>
        <service android:name="vn.edu.phenikaa.better_phenikaa_schedule.findbike.VehicleCaptureService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="location" />
        <receiver android:name="vn.edu.phenikaa.better_phenikaa_schedule.findbike.VehicleFenceReceiver" android:exported="false" />
        <receiver android:name="vn.edu.phenikaa.better_phenikaa_schedule.findbike.VehicleScheduleReceiver" android:exported="false" />
        <service android:name="vn.edu.phenikaa.better_phenikaa_schedule.findbike.VehicleExitNotificationListener"
            android:exported="false"
            android:label="BPA — Nhận xe ra cổng"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver android:name="vn.edu.phenikaa.better_phenikaa_schedule.findbike.VehicleBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
