<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/schedule_widget_outline"
    android:clipToOutline="true"
    android:outlineProvider="background">
    <ImageView
        android:id="@+id/overview_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />
    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/overview_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textSize="14sp" />
        <ImageView
            android:id="@+id/overview_calendar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="5dp"
            android:contentDescription="Chọn ngày"
            android:src="@drawable/ic_widget_calendar" />
        <TextView
            android:id="@+id/overview_reload"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:contentDescription="Đồng bộ"
            android:text="↻"
            android:textSize="24sp" />
        <ImageView
            android:id="@+id/overview_mode"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="5dp"
            android:contentDescription="Lịch thi"
            android:src="@drawable/ic_widget_bell" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/overview_cards"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
        <TextView
            android:id="@+id/overview_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:visibility="gone" />
        <TextView
            android:id="@+id/overview_previous"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:gravity="center"
            android:text="‹"
            android:textSize="25sp"
            android:contentDescription="Nhóm môn trước" />
        <TextView
            android:id="@+id/overview_next"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center"
            android:text="›"
            android:textSize="25sp"
            android:contentDescription="Nhóm môn tiếp theo" />
    </FrameLayout>
</LinearLayout>
</FrameLayout>
