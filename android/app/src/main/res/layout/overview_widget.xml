<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/overview_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@drawable/schedule_widget_outline" android:clipToOutline="true" android:outlineProvider="background">
 <ImageView android:id="@+id/overview_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="7dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
   <ImageView android:id="@+id/overview_emblem" android:layout_width="34dp" android:layout_height="28dp" android:paddingEnd="5dp" android:src="@drawable/ic_widget_study" android:contentDescription="@null"/>
   <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
    <TextView android:id="@+id/overview_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="16sp" android:textStyle="bold"/>
    <TextView android:id="@+id/overview_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textSize="11sp"/>
   </LinearLayout>
   <ImageView android:id="@+id/overview_calendar" android:layout_width="31dp" android:layout_height="32dp" android:contentDescription="Chọn ngày" android:padding="5dp" android:src="@drawable/ic_widget_calendar"/>
   <TextView android:id="@+id/overview_reload" android:layout_width="31dp" android:layout_height="32dp" android:contentDescription="Đồng bộ" android:gravity="center" android:text="↻" android:textSize="26sp"/>
   <ImageView android:id="@+id/overview_mode" android:layout_width="31dp" android:layout_height="32dp" android:contentDescription="Chuyển lịch học và lịch thi" android:padding="5dp" android:src="@drawable/ic_widget_switch"/>
  </LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
   <LinearLayout android:id="@+id/overview_cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="vertical"/>
   <TextView android:id="@+id/overview_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="14sp" android:visibility="gone"/>
  </FrameLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="29dp">
   <ImageView android:id="@+id/overview_progress" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
   <TextView android:id="@+id/overview_status" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:textSize="11sp"/>
   <LinearLayout android:id="@+id/overview_navigation" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/overview_previous" android:layout_width="30dp" android:layout_height="match_parent" android:contentDescription="Trang trước" android:gravity="center" android:text="‹" android:textSize="25sp"/>
    <TextView android:id="@+id/overview_page" android:layout_width="30dp" android:layout_height="match_parent" android:gravity="center" android:textSize="10sp"/>
    <TextView android:id="@+id/overview_next" android:layout_width="30dp" android:layout_height="match_parent" android:contentDescription="Trang tiếp" android:gravity="center" android:text="›" android:textSize="25sp"/>
   </LinearLayout>
   </LinearLayout>
  </FrameLayout>
 </LinearLayout>
</FrameLayout>
